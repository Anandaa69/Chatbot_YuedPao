# =================================================================
# Chatbot YuedPao - Environment Variables Configuration Template
# Copy this file to '.env' and fill in your actual LINE credentials
# =================================================================

# LINE Messaging API Credentials (from LINE Developers Console)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Database & Environment Settings
DATABASE_URL=sqlite:///./yuedpao_chatbot.db
ENVIRONMENT=development

# Flask Server Options
PORT=5000
HOST=0.0.0.0
